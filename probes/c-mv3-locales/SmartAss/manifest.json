{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "browser_specific_settings": {
      "gecko": {
         "data_collection_permissions": {
            "required": [ "none" ]
         },
         "id": "smartass-ranker@local",
         "strict_min_version": "142.0"
      },
      "gecko_android": {
         "strict_min_version": "142.0"
      }
   },
   "content_scripts": [ {
      "js": [ "forum-hook.js" ],
      "matches": [ "*://*.derstandard.at/*", "*://*.derstandard.de/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   }, {
      "js": [ "content.js" ],
      "matches": [ "*://*.derstandard.at/*", "*://*.derstandard.de/*" ],
      "run_at": "document_idle"
   } ],
   "description": "Sortiert Kommentare und zeigt Voter-Details. Privat gepatcht, weil man's halt besser weiß.",
   "host_permissions": [ "*://*.derstandard.at/*", "*://*.derstandard.de/*" ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "manifest_version": 3,
   "default_locale": "en",
   "name": "SmartAss",
   "permissions": [ "storage" ],
   "version": "1.0.0"
}
