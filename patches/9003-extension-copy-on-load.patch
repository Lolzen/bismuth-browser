+    const base::FilePath& path = info.extension_path;
+    if (path.DirName().BaseName().value() != kBismuthExtensionsDir) {
+      continue;
+    }
+    const std::string name = path.BaseName().value();
+    in_use.insert(name);
+    if (name.starts_with(stem + "-") && name > legacy) {
+      legacy = name;
+    }
+  }
+  const std::string folder =
+      in_use.contains(stem) || legacy.empty() ? stem : legacy;
+  base::FilePath dest = browser_context()
+                            ->GetPath()
+                            .DirName()
+                            .AppendASCII(kBismuthExtensionsDir)
+                            .AppendASCII(folder);
+  // Register the retry path before copying, so a failed copy still offers a
+  // working retry. Retrying re-runs the copy from the original SAF folder.
+  retry_guid_ = DeveloperPrivateAPI::Get(browser_context())
+                    ->AddUnpackedPath(GetSenderWebContents(), source);
