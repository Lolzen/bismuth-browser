+namespace {
+
+// Where copies of unpacked extensions live: one level above the profile.
+// Copies kept inside the profile kept vanishing without any Chromium log
+// entry, from 149 onwards; the profile is Chromium's own territory and it
+// tidies up what it does not recognise. This sits next to the component
+// directories instead.
+constexpr char kBismuthExtensionsDir[] = "BismuthExtensions";
+
+// A folder under kBismuthExtensionsDir that no installed extension points to
+// is only removed once it is this old. A load running in parallel may have
+// just moved its copy into place without having registered it yet.
+constexpr base::TimeDelta kOrphanMinAge = base::Hours(1);
+
+int64_t NowForFileName() {
+  return base::Time::Now().ToDeltaSinceWindowsEpoch().InMicroseconds();
+}
+
+// Copies a SAF-backed directory tree into app storage. Running an unpacked
+// extension straight off a document provider is unusably slow: every file
+// access crosses a Binder IPC.
+//
+// `to` is the same for every load of the same source folder. An unpacked
+// extension's ID is derived from its path, so this keeps the ID - and with it
+// the extension's settings and storage - across reloads. The previous copy is
+// replaced in place.
+//
+// `in_use` holds the folder names under kBismuthExtensionsDir that installed
+// extensions point to. Everything else there is left over from removed
+// extensions and is deleted afterwards.
+bool CopyVirtualDirectory(const base::FilePath& from,
+                          const base::FilePath& to,
+                          const std::set<std::string>& in_use,
+                          base::RepeatingCallback<void(int, int)> on_progress) {
+  int total = 0;
+  {
+    // Over SAF the requested type is passed through to the directory
+    // listing, so asking for FILES alone hides the subdirectories and the
+    // recursion never descends. Ask for both and skip directories here.
+    base::FileEnumerator counter(
+        from, true,
+        base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath p = counter.Next(); !p.empty(); p = counter.Next()) {
+      if (!counter.GetInfo().IsDirectory()) {
+        ++total;
+      }
+    }
+  }
+  on_progress.Run(0, total);
+  int copied = 0;
+  // Build the copy outside the extensions area and move it into place in one
+  // step, the way Chromium installs a CRX. A failed attempt therefore cannot
+  // destroy a previously working copy. Each attempt gets its own name, so two
+  // loads of the same folder cannot write into each other.
+  const base::FilePath temp_root = to.DirName().DirName().AppendASCII("Temp");
+  const base::FilePath temp = temp_root.AppendASCII(
+      to.BaseName().value() + "-" + base::NumberToString(NowForFileName()));
+  const base::FilePath previous = temp.AddExtensionASCII("previous");
+  // Every early return below would otherwise leave a partial copy behind.
+  // After a successful swap both are gone and this is a no-op.
+  base::ScopedClosureRunner remove_temp(base::BindOnce(
+      [](const base::FilePath& a, const base::FilePath& b) {
+        base::DeletePathRecursively(a);
+        base::DeletePathRecursively(b);
+      },
+      temp, previous));
+  if (!base::CreateDirectory(temp)) {
+    return false;
+  }
+  base::FileEnumerator traversal(
+      from, true,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath p = traversal.Next(); !p.empty(); p = traversal.Next()) {
+    base::FilePath target = temp;
+    if (!from.AppendRelativePath(p, &target)) {
+      continue;
+    }
+    if (traversal.GetInfo().IsDirectory()) {
+      if (!base::CreateDirectory(target)) {
+        return false;
+      }
+      continue;
+    }
+    base::File in(p, base::File::FLAG_OPEN | base::File::FLAG_READ);
+    if (!in.IsValid()) {
+      return false;
+    }
+    std::string data;
+    std::vector<uint8_t> buf(65536);
+    while (true) {
+      std::optional<size_t> n = in.ReadAtCurrentPos(base::span(buf));
+      if (!n) {
+        return false;
+      }
+      if (*n == 0) {
+        break;
+      }
+      data.append(reinterpret_cast<const char*>(buf.data()), *n);
+    }
+    // The enumerator does not guarantee that a directory is reported before
+    // the files inside it, so make sure the parent exists.
+    if (!base::CreateDirectory(target.DirName())) {
+      return false;
+    }
+    if (!base::WriteFile(target, data)) {
+      return false;
+    }
+    ++copied;
+    if (copied % 10 == 0) {
+      on_progress.Run(copied, total);
+    }
+  }
+  on_progress.Run(copied, total);
+
+  if (!base::PathExists(temp.AppendASCII("manifest.json"))) {
+    return false;
+  }
+
+  // Swap the new copy in. The old one is moved aside first and put back if
+  // the swap fails, so an installed extension never loses its files.
+  if (!base::CreateDirectory(to.DirName())) {
+    return false;
+  }
+  const bool had_previous = base::PathExists(to);
+  if (had_previous && !base::Move(to, previous)) {
+    return false;
+  }
+  if (!base::Move(temp, to) ||
+      !base::PathExists(to.AppendASCII("manifest.json"))) {
+    if (had_previous) {
+      base::DeletePathRecursively(to);
+      base::Move(previous, to);
+    }
+    return false;
+  }
+
+  // Chromium never deletes the directory of an unpacked extension, not even
+  // on removal. Sweep folders no installed extension points to anymore. A
+  // folder that is still registered is never touched: deleting it would leave
+  // the extension installed but broken.
+  const base::Time cutoff = base::Time::Now() - kOrphanMinAge;
+  base::FileEnumerator siblings(to.DirName(), false,
+                                base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath p = siblings.Next(); !p.empty(); p = siblings.Next()) {
+    const std::string name = p.BaseName().value();
+    if (name == to.BaseName().value() || in_use.contains(name) ||
+        siblings.GetInfo().GetLastModifiedTime() > cutoff) {
+      continue;
+    }
+    base::DeletePathRecursively(p);
+  }
+
+  return true;
+}
