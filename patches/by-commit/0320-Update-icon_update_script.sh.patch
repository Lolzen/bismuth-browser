From 3e139252b9e18e97f4fe07b39057feb5b57b4852 Mon Sep 17 00:00:00 2001
From: Eduard Ursu <eduardursu78@gmail.com>
Date: Thu, 12 Aug 2021 00:22:05 +0200
Subject: [PATCH 320/506] Update icon_update_script.sh

---
 toolbox/icon_update_script.sh | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/toolbox/icon_update_script.sh b/toolbox/icon_update_script.sh
index c8dc2d3e..8f822e0d 100644
--- a/toolbox/icon_update_script.sh
+++ b/toolbox/icon_update_script.sh
@@ -1,10 +1,10 @@
 
-find ~/ -name $2 | while read filename
+find ./chrome ./components -name "$2" | while read filename
 do
-  width=`identify -format '%w' $filename`;
-  height=`identify -format '%w' $filename`;
+  width=$(identify -format '%w' "$filename");
+  height=$(identify -format '%w' "$filename");
   psize=0.16;
-  swidth=$(echo "scale=0;($width - $psize*$width)/1" | bc);
+ #swidth=$(echo "scale=0;($width - $psize*$width)/1" | bc);
   sheight=$(echo "scale=0;($height - $psize*$height)/1" | bc);
   echo " $filename ";
   if [ -z "$3" ]
@@ -12,9 +12,9 @@ do
         echo "\$3 is empty";
   else
         echo "Icon color parameter is NOT empty : $3";
-        sed -e "s/svg xmlns/svg fill='$3' xmlns/g" $1 > /tmp/tmp.svg
-        mv /tmp/tmp.svg $1
+        sed -e "s/svg xmlns/svg fill='$3' xmlns/g" "$1" > /tmp/tmp.svg
+        mv /tmp/tmp.svg "$1"
   fi
-  rsvg-convert $1 -h $sheight -o /tmp/tmp.png;
-  convert /tmp/tmp.png -background none -gravity center -extent $width'x'$height $filename;
+  rsvg-convert "$1" -h "$sheight" -o /tmp/tmp.png;
+  convert /tmp/tmp.png -background none -gravity center -extent "$width"'x'"$height" "$filename";
 done
