From 48a1eab7b700195ffa760965fc586d40edde3e5f Mon Sep 17 00:00:00 2001
From: Eduard Ursu <eduardursu78@gmail.com>
Date: Thu, 22 Jul 2021 14:18:30 +0200
Subject: [PATCH 043/506] Update download_icon_from_fontawesome.yml

---
 .github/workflows/download_icon_from_fontawesome.yml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/download_icon_from_fontawesome.yml b/.github/workflows/download_icon_from_fontawesome.yml
index c2dd8ca1..e66f9847 100644
--- a/.github/workflows/download_icon_from_fontawesome.yml
+++ b/.github/workflows/download_icon_from_fontawesome.yml
@@ -43,12 +43,12 @@ jobs:
       - name: Install ImageMagick
         run: sudo apt-get install imagemagick
         
-      - name: Execute Script - Replace match icons with new FA
+      - name: Execute Script - Replace icons with new FA ones
         run: bash iconUpdateScript.sh "./node_modules/@fortawesome/fontawesome-pro/svgs/${{ github.event.inputs.iconTypeFA }}/${{ github.event.inputs.iconNameFA }}.svg" "${{ github.event.inputs.fileNameInChromium }}" "${{ github.event.inputs.fillColor }}"
       
       - name: Git Auto Commit
         uses: stefanzweifel/git-auto-commit-action@v4.11.0
         with:
           # Commit message
-          commit_message: Update ${{ github.event.inputs.iconNameFA }} icon
+          commit_message: Update ${{ github.event.inputs.fileNameInChromium }} with ${{ github.event.inputs.iconTypeFA }}/${{ github.event.inputs.iconNameFA }} icon
           file_pattern: chrome/*/*.png
