---
 .github/workflows/rebase_kiwi_on_top_of_chromium.yml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/rebase_kiwi_on_top_of_chromium.yml b/.github/workflows/rebase_kiwi_on_top_of_chromium.yml
index 490b945c..9bf85fb0 100644
