From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Tue, 10 Aug 2021 03:24:16 +0300
Subject: [PATCH 213/506] Update build_apk.yml

---
 .github/workflows/build_apk.yml | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/build_apk.yml b/.github/workflows/build_apk.yml
index 5999ad3a..280f52fb 100644
--- a/.github/workflows/build_apk.yml
+++ b/.github/workflows/build_apk.yml
@@ -22,11 +22,13 @@ jobs:
         run: curl --no-buffer -s 'https://${{ secrets.BUILD_SERVER }}/build_apk.php?build_key=${{ secrets.BUILD_KEY }}&git_user=${{ github.repository_owner }}&git_repository=${{ github.event.repository.name }}&git_runid=${{ github.run_id }}&git_branch=${{ steps.branch-name.outputs.current_branch }}'
 
       - name: Downloading APK
-        run: wget 'https://${{ secrets.BUILD_SERVER }}/apks/${{ github.run_id }}/out.apk'
+        run: wget -q 'https://${{ secrets.BUILD_SERVER }}/apks/${{ github.run_id }}/out.apk'
 
       - name: Creating release
         id: create_release
         uses: actions/create-release@v1.1.4
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         with:
           tag_name: ${{ github.run_id }}
           release_name: Test build ${{ github.run_id }} initiated by ${{ github.actor }}
@@ -37,6 +39,8 @@ jobs:
 
       - name: Uploading test apk (arm64)
         uses: actions/upload-release-asset@v1
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         with:
           upload_url: ${{ steps.create_release.outputs.upload_url }}
           asset_path: ./out.apk
