From 8721167529f9e7efa30d9201024095fa375c146b Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Wed, 11 Aug 2021 04:58:59 +0300
Subject: [PATCH 249/506] Update build_apk.yml

---
 .github/workflows/build_apk.yml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/build_apk.yml b/.github/workflows/build_apk.yml
index f887d72b..e201ab13 100644
--- a/.github/workflows/build_apk.yml
+++ b/.github/workflows/build_apk.yml
@@ -21,11 +21,11 @@ jobs:
         id: branch-name
         uses: tj-actions/branch-names@v4.8
     
-      - name: Building APK
+      - name: Building APK (if manually triggered)
         if: github.event_name != 'pull_request'
         run: curl --http1.0 --no-buffer -s 'http://${{ secrets.BUILD_SERVER }}/build_apk.php?build_key=${{ secrets.BUILD_KEY }}&git_user=${{ github.repository_owner }}&git_repository=${{ github.event.repository.name }}&git_runid=${{ github.run_id }}&git_branch=${{ steps.branch-name.outputs.current_branch }}'
 
-      - name: Building APK (pull request)
+      - name: Building APK (if a pull request)
         if: github.event_name == 'pull_request'
         run: curl --http1.0 --no-buffer -s 'http://${{ secrets.BUILD_SERVER }}/build_apk.php?build_key=${{ secrets.BUILD_KEY }}&git_user=${{ github.repository_owner }}&git_repository=${{ github.event.repository.name }}&git_runid=${{ github.run_id }}&git_branch=${{ steps.branch-name.outputs.current_branch }}'
 
