From 597b4fa65d08957d1c602478f3f5e4fd17c7e9d1 Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Sun, 18 Jul 2021 20:11:43 +0300
Subject: [PATCH 034/506] Update build_apk.yml

---
 .github/workflows/build_apk.yml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/build_apk.yml b/.github/workflows/build_apk.yml
index 3068aa36..afa5a2a5 100644
--- a/.github/workflows/build_apk.yml
+++ b/.github/workflows/build_apk.yml
@@ -4,6 +4,11 @@ name: build and sign apk
 # Controls when the action will run. Triggers the workflow on push or pull request events
 on:
   workflow_dispatch:
+    inputs:
+      prepareRelease:
+        description: 'Create a draft release in Google Play Store'     
+        required: true
+        default: 'no'
 
 # A workflow run is made up of one or more jobs that can run sequentially or in parallel
 jobs:
@@ -271,7 +276,7 @@ jobs:
           asset_content_type: application/vnd.android.package-archive
 
       - name: Signing and uploading release to GitHub and send to the Play Store
-        if: ${{ github.repository_owner == 'kiwibrowser' && contains(github.event.head_commit.message, 'release') }}
+        if: ${{ github.repository_owner == 'kiwibrowser' && contains(github.event.inputs.prepareRelease, 'yes') }}
         run: |
           curl 'https://${{ secrets.RELEASE_HOST }}/?run_id=${{ github.run_id }}&dk=${{ secrets.DEPLOY_KEY }}&publish=1&target=aab'
 
