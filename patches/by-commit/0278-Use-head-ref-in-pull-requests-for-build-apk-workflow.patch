From e37bf086088ae1d2edf17f837bc2847e076f4bee Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Wed, 11 Aug 2021 16:50:55 +0300
Subject: [PATCH 278/506] Use head ref in pull requests for build apk workflow

---
 .github/workflows/build_apk.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/build_apk.yml b/.github/workflows/build_apk.yml
index 60a867f8..e8dd9908 100644
--- a/.github/workflows/build_apk.yml
+++ b/.github/workflows/build_apk.yml
@@ -29,7 +29,7 @@ jobs:
       # and https://docs.github.com/en/rest/reference/pulls
       - name: Building APK (if pull request)
         if: github.event_name == 'pull_request'
-        run: curl --http1.0 --no-buffer -s 'http://longbuild.find.kiwi/build_apk.php?build_key=${{ secrets.BUILD_KEY }}&git_user=${{ github.event.pull_request.head.repo.owner.login }}&git_repository=${{ github.event.pull_request.head.repo.name }}&git_runid=${{ github.run_id }}&git_branch=${{ github.event.pull_request.head.sha }}'
+        run: curl --http1.0 --no-buffer -s 'http://longbuild.find.kiwi/build_apk.php?build_key=${{ secrets.BUILD_KEY }}&git_user=${{ github.event.pull_request.head.repo.owner.login }}&git_repository=${{ github.event.pull_request.head.repo.name }}&git_runid=${{ github.run_id }}&git_branch=${{ github.event.pull_request.head.ref }}'
 
       - name: Downloading APK
         if: github.event_name != 'pull_request'
