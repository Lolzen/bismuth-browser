From 146abbfba9e971001770a601bab829d2b89f0ab8 Mon Sep 17 00:00:00 2001
From: Arnaud GRANAL <arnaud@geometry.ee>
Date: Sat, 7 Aug 2021 01:01:56 +0000
Subject: [PATCH 174/506] Add assets from Kiwi Browser

---
 chrome/android/java/res/values-hdpi/dimens.xml         |  4 ++++
 chrome/android/java/res/values-xhdpi/dimens.xml        |  4 ++++
 .../res_chromium_base/values/channel_constants.xml     | 10 +++++-----
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/chrome/android/java/res/values-hdpi/dimens.xml b/chrome/android/java/res/values-hdpi/dimens.xml
index 51d8f55e..7c0b0147 100644
--- a/chrome/android/java/res/values-hdpi/dimens.xml
+++ b/chrome/android/java/res/values-hdpi/dimens.xml
@@ -10,6 +10,10 @@
     <!-- The size of the bounding box for favicons. -->
     <dimen name="compositor_tab_title_favicon_size">16dp</dimen>
 
+    <!-- TabSwitcher -->
+    <dimen name="tabswitcher_border_frame_padding_left">5.333dp</dimen>
+    <dimen name="tabswitcher_border_frame_padding_top">49.333dp</dimen>
+
     <!-- Location bar -->
     <dimen name="location_bar_status_separator_width">0.5dp</dimen>
 </resources>
diff --git a/chrome/android/java/res/values-xhdpi/dimens.xml b/chrome/android/java/res/values-xhdpi/dimens.xml
index 7e17cb5a..de9197f4 100644
--- a/chrome/android/java/res/values-xhdpi/dimens.xml
+++ b/chrome/android/java/res/values-xhdpi/dimens.xml
@@ -9,4 +9,8 @@
 <resources>
     <!-- The size of the bounding box for favicons. -->
     <dimen name="compositor_tab_title_favicon_size">18dp</dimen>
+
+    <!-- TabSwitcher -->
+    <dimen name="tabswitcher_border_frame_padding_left">5.5dp</dimen>
+    <dimen name="tabswitcher_border_frame_padding_top">49.5dp</dimen>
 </resources>
diff --git a/chrome/android/java/res_chromium_base/values/channel_constants.xml b/chrome/android/java/res_chromium_base/values/channel_constants.xml
index 460cbd79..0dd1a1cf 100644
--- a/chrome/android/java/res_chromium_base/values/channel_constants.xml
+++ b/chrome/android/java/res_chromium_base/values/channel_constants.xml
@@ -5,9 +5,9 @@
 
 <resources xmlns:android="http://schemas.android.com/apk/res/android">
     <!-- The application name displayed to the user. -->
-    <string name="app_name" translatable="false">Chromium</string>
-    <string name="bookmark_widget_title" translatable="false">Chromium bookmarks</string>
-    <string name="search_widget_title" translatable="false">Chromium search</string>
-    <string name="quick_action_search_widget_title" translatable="false">Chromium quick action search</string>
-    <string name="dino_widget_title" translatable="false">Chromium dino</string>
+    <string name="app_name" translatable="false">Kiwi Browser</string>
+    <string name="bookmark_widget_title" translatable="false">Kiwi Browser bookmarks</string>
+    <string name="search_widget_title" translatable="false">Kiwi Browser search</string>
+    <string name="quick_action_search_widget_title" translatable="false">Kiwi Browser quick action search</string>
+    <string name="dino_widget_title" translatable="false">Kiwi Browser bird</string>
 </resources>
