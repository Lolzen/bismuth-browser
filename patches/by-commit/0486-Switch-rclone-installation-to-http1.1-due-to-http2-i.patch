 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/build_and_sign_release_apk.yml b/.github/workflows/build_and_sign_release_apk.yml
index 90d86a34..4aa4018c 100644
--- a/.github/workflows/build_and_sign_release_apk.yml
+++ b/.github/workflows/build_and_sign_release_apk.yml
@@ -149,7 +149,7 @@ jobs:
 
     steps:
       - name: Installing rclone
-        run: curl https://rclone.org/install.sh | sudo bash
+        run: curl --http1.1 https://rclone.org/install.sh | sudo bash
     
       - name: Creating rclone config
         run: |
