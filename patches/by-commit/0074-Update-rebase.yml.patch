From 061cf6757618a2c03af1f706630cc22e5f981fe2 Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Mon, 2 Aug 2021 05:17:37 +0300
Subject: [PATCH 074/506] Update rebase.yml

---
 .github/workflows/rebase.yml | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/rebase.yml b/.github/workflows/rebase.yml
index 115dcd74..0f0f49ce 100644
--- a/.github/workflows/rebase.yml
+++ b/.github/workflows/rebase.yml
@@ -15,11 +15,12 @@ jobs:
       - uses: actions/checkout@v2
 
       - name: Loading settings from CHROMIUM_VERSION
-        run: source CHROMIUM_VERSION; export $(cut -d= -f1 CHROMIUM_VERSION | grep -vF '#')
+        run: |
+          source CHROMIUM_VERSION; export $(cut -d= -f1 CHROMIUM_VERSION | grep -vF '#')
+          env | grep -F CHROMIUM_ >> $GITHUB_ENV
         
       - name: Downloading files
-        run: wget "https://chromium.googlesource.com/chromium/src/+/refs/tags/${CHROMIUM_MAJOR}.${CHROMIUM_MINOR}.${CHROMIUM_BUILD}.${CHROMIUM_PATCH}/chrome/browser/resources/extensions/extensions.html?format=TEXT' -O chrome/browser/resources/extensions/extensions.html
+        run: wget "https://chromium.googlesource.com/chromium/src/+/refs/tags/${{ env.CHROMIUM_MAJOR }}.${{ env.CHROMIUM_MINOR }}.${{ env.CHROMIUM_BUILD }}.${{ env.CHROMIUM_PATCH }}/chrome/browser/resources/extensions/extensions.html?format=TEXT' -O chrome/browser/resources/extensions/extensions.html
         
       - name: Outputting file
         run: cat chrome/browser/resources/extensions/extensions.html | base64 --decode
-    
