From d6f1ab24d2cdf41ba98607140d4424967f946995 Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Mon, 2 Aug 2021 06:38:18 +0300
Subject: [PATCH 092/506] Update rebase.yml

---
 .github/workflows/rebase.yml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/rebase.yml b/.github/workflows/rebase.yml
index b7be06e7..1926601c 100644
--- a/.github/workflows/rebase.yml
+++ b/.github/workflows/rebase.yml
@@ -29,8 +29,11 @@ jobs:
       - name: Checking out Chromium
         run: git clone --filter=tree:0 --no-checkout https://github.com/chromium/chromium.git chromium
 
+      - name: Listing folders
+        run: find . -type d > folders.txt
+
       - name: Limiting the list of files to checkout
-        run: cd chromium && find -type d | git sparse-checkout set --stdin
+        run: cd chromium && cat ../folders.txt | git sparse-checkout set --stdin
 
       - name: Switching Chromium base branch
         run: cd chromium && git read-tree -mu ${{ env.CHROMIUM_MAJOR }}.${{ env.CHROMIUM_MINOR }}.${{ env.CHROMIUM_BUILD }}.${{ env.CHROMIUM_PATCH }}
