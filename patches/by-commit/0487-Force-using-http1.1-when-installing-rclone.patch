From 92b44c64907148ba068ac0811e1623e0e6ef4449 Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Fri, 28 Jul 2023 14:31:54 +0300
Subject: [PATCH 487/506] Force using http1.1 when installing rclone

---
 .github/workflows/build_and_sign_release_apk.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/build_and_sign_release_apk.yml b/.github/workflows/build_and_sign_release_apk.yml
index 4aa4018c..5583415b 100644
--- a/.github/workflows/build_and_sign_release_apk.yml
+++ b/.github/workflows/build_and_sign_release_apk.yml
@@ -45,7 +45,7 @@ jobs:
         run: sudo apt-get update
 
       - name: Installing rclone
-        run: sudo -v ; curl https://rclone.org/install.sh | sudo bash -s beta
+        run: sudo -v ; curl --http1.1 https://rclone.org/install.sh | sudo bash -s beta
 
       - name: Installing Python and OpenJDK
         run: sudo apt-get install -y 2to3 python2-minimal python2 dh-python python-is-python3 openjdk-8-jdk-headless libncurses5 ccache
