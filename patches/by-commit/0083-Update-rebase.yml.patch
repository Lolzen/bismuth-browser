From 64bf79786f146b6aa8bdb5fa89e036d7b13c27b2 Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Mon, 2 Aug 2021 06:13:40 +0300
Subject: [PATCH 083/506] Update rebase.yml

---
 .github/workflows/rebase.yml | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/rebase.yml b/.github/workflows/rebase.yml
index 5d4f697e..afa84319 100644
--- a/.github/workflows/rebase.yml
+++ b/.github/workflows/rebase.yml
@@ -23,10 +23,13 @@ jobs:
       # git clone --filter=tree:0 <url> creates a treeless clone.
       # These clones download all reachable commits while fetching trees and blobs on-demand. These clones are best for build environments where the repository will be deleted after a single build, but you still need access to commit history
       - name: Checking out Chromium
-        run: git clone --filter=tree:0 https://github.com/chromium/chromium.git chromium
+        run: git clone --filter=tree:0 --no-checkout https://github.com/chromium/chromium.git chromium
+
+      - name: Limiting the list of files to checkout
+        run: cd chromium && git sparse-checkout set chrome/android
 
       - name: Switching Chromium base branch
-        run: cd chromium && git checkout ${{ env.CHROMIUM_MAJOR }}.${{ env.CHROMIUM_MINOR }}.${{ env.CHROMIUM_BUILD }}.${{ env.CHROMIUM_PATCH }}
+        run: cd chromium && git read-tree -mu ${{ env.CHROMIUM_MAJOR }}.${{ env.CHROMIUM_MINOR }}.${{ env.CHROMIUM_BUILD }}.${{ env.CHROMIUM_PATCH }}
 
       - name: Showing history for one file
         run: cd chromium && git log --no-pager log --decorate=short --pretty=oneline -n1 chrome/browser/resources/extensions/extensions.html
