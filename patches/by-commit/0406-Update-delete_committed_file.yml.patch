From 575246f717d2be22b55102c67d08d1441b37054e Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Sun, 15 Aug 2021 21:10:07 +0300
Subject: [PATCH 406/506] Update delete_committed_file.yml

---
 .github/workflows/delete_committed_file.yml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/delete_committed_file.yml b/.github/workflows/delete_committed_file.yml
index 4168ba8e..db270a23 100644
--- a/.github/workflows/delete_committed_file.yml
+++ b/.github/workflows/delete_committed_file.yml
@@ -11,6 +11,9 @@ jobs:
   rename:
     runs-on: ubuntu-latest
     steps:
+      - name: Installing BFG
+        run: wget https://repo1.maven.org/maven2/com/madgag/bfg/1.14.0/bfg-1.14.0.jar
+    
       - uses: actions/checkout@v2
         with:
           fetch-depth: 0
@@ -20,6 +23,6 @@ jobs:
           git config --global user.email "github@actions"
           git config --global user.name "Repository manager"
             
-      - run: bfg --delete-files ${{ github.event.inputs.filename }} .
+      - run: java -ar bfg-1.14.0.jar --delete-files ${{ github.event.inputs.filename }} .
       
       - run: git push
