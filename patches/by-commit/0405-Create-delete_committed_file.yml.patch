From 6a937d6bf97a907242e54c226a84d952263b059c Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Sun, 15 Aug 2021 21:01:11 +0300
Subject: [PATCH 405/506] Create delete_committed_file.yml

---
 .github/workflows/delete_committed_file.yml | 25 +++++++++++++++++++++
 1 file changed, 25 insertions(+)
 create mode 100644 .github/workflows/delete_committed_file.yml

diff --git a/.github/workflows/delete_committed_file.yml b/.github/workflows/delete_committed_file.yml
new file mode 100644
index 00000000..4168ba8e
--- /dev/null
+++ b/.github/workflows/delete_committed_file.yml
@@ -0,0 +1,25 @@
+name: 'Any branch: Delete a committed file'
+
+on:
+  workflow_dispatch:
+    inputs:
+      filename:
+        description: 'The filename to delete (all history will be deleted for this file)'     
+        required: true
+
+jobs:
+  rename:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v2
+        with:
+          fetch-depth: 0
+        
+      - name: Setting-up GitHub username
+        run: |
+          git config --global user.email "github@actions"
+          git config --global user.name "Repository manager"
+            
+      - run: bfg --delete-files ${{ github.event.inputs.filename }} .
+      
+      - run: git push
