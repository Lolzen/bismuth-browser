diff --git a/.github/workflows/rename_directory.yml b/.github/workflows/rename_directory.yml
new file mode 100644
index 00000000..e9aae3c3
--- /dev/null
+++ b/.github/workflows/rename_directory.yml
@@ -0,0 +1,23 @@
+name: 'Any branch: Rename directory'
+
+on:
+  workflow_dispatch:
+    inputs:
+      source_directory:
+        description: 'Source directory path'     
+        required: true
+      destination_directory:
+        description: 'Destination directory path'     
+        required: true
+
+jobs:
+  rename:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v2
+      
+      - run: ls -laR
+      
+      - run: git mv ${{ github.event.inputs.source_directory }} ${{ github.event.inputs.destination_directory }}
+      
+      - uses: EndBug/add-and-commit@v5.1.0
