---
 .github/workflows/rebase_kiwi_on_top_of_chromium.yml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/rebase_kiwi_on_top_of_chromium.yml b/.github/workflows/rebase_kiwi_on_top_of_chromium.yml
index 8eab14e1..490b945c 100644
