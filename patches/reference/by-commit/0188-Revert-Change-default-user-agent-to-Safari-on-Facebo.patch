From: Arnaud GRANAL <arnaud@geometry.ee>
Date: Sat, 7 Aug 2021 23:19:55 +0000
Subject: [PATCH 188/506] Revert "Change default user-agent to Safari on
 Facebook"

This reverts commit bb268dfef4a4a8a3532964463ae52e359521b058.
---
 net/url_request/url_request_http_job.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/net/url_request/url_request_http_job.cc b/net/url_request/url_request_http_job.cc
index cb302364..b8c4f53b 100644
--- a/net/url_request/url_request_http_job.cc
+++ b/net/url_request/url_request_http_job.cc
@@ -337,7 +337,7 @@ void URLRequestHttpJob::OnGotFirstPartySetMetadata(
