From c40ff45f4f9cf6be952695b6dac23310a50b9dd3 Mon Sep 17 00:00:00 2001
From: Kiwi Browser <40272275+kiwibrowser@users.noreply.github.com>
Date: Mon, 2 Aug 2021 02:11:41 +0300
Subject: [PATCH 048/506] Create download_translations_from_crowdin.yml

---
 .../download_translations_from_crowdin.yml     | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)
 create mode 100644 .github/workflows/download_translations_from_crowdin.yml

diff --git a/.github/workflows/download_translations_from_crowdin.yml b/.github/workflows/download_translations_from_crowdin.yml
new file mode 100644
index 00000000..0e541511
--- /dev/null
+++ b/.github/workflows/download_translations_from_crowdin.yml
@@ -0,0 +1,18 @@
+name: Download translations from Crowdin
+
+on:
+  workflow_dispatch
+      
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v2.3.4
+          
+      - name: Git auto-commit
+        uses: stefanzweifel/git-auto-commit-action@v4.11.0
+        with:
+          # Commit message
+          commit_message: Updated translation files from Crowdin
+          file_pattern: chrome/android/java/res/*/
