 2 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/resources/new_tab_page_instant/local_ntp.css b/chrome/browser/resources/new_tab_page_instant/local_ntp.css
index 6878b9c8..336a2dd6 100644
--- a/chrome/browser/resources/new_tab_page_instant/local_ntp.css
+++ b/chrome/browser/resources/new_tab_page_instant/local_ntp.css
@@ -103,7 +103,7 @@ body {
   min-height: 100%;
   overflow-x: hidden;
   -webkit-text-size-adjust: 100%;
-  background: white; /* this is to force night mode to trigger */
+  background: white;
 }
 
 body.inited {
@@ -784,9 +784,22 @@ input:checked + .toggle::before {
 
 #bookmarks-grid, #fake-bookmarks-grid, #ideas-grid {
     margin: 2%;
+    margin-top: 0px;
     position: relative;
 }
 
+@media (max-width: 450px) {
+  #bookmarks-grid, #fake-bookmarks-grid, #ideas-grid {
+    min-height: 208px;
+  }
+}
+
+@media (min-width: 450px) {
+  #bookmarks-grid, #fake-bookmarks-grid, #ideas-grid {
+    min-height: 104px;
+  }
+}
+
 #fake-bookmarks-grid {
     z-index: -99999;
 }
