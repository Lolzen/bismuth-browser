From 8676af40245b3d92dcb2676764cab8d91ece7ad4 Mon Sep 17 00:00:00 2001
From: Eduard Ursu <eduardursu78@gmail.com>
Date: Thu, 22 Jul 2021 12:52:42 +0200
Subject: [PATCH 041/506] Create iconUpdateScript.sh

---
 iconUpdateScript.sh | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)
 create mode 100644 iconUpdateScript.sh

diff --git a/iconUpdateScript.sh b/iconUpdateScript.sh
new file mode 100644
index 00000000..4f0cf3c1
--- /dev/null
+++ b/iconUpdateScript.sh
@@ -0,0 +1,20 @@
+
+find ./chrome -name $2 | while read filename
+do
+  width=`identify -format '%w' $filename`;
+  height=`identify -format '%w' $filename`;
+  psize=0.16;
+  swidth=$(echo "scale=0;($width - $psize*$width)/1" | bc);
+  sheight=$(echo "scale=0;($height - $psize*$height)/1" | bc);
+  echo " $filename ";
+  if [ -z "$3" ]
+  then
+        echo "\$3 is empty";
+  else
+        echo "Icon color parameter is NOT empty : $3";
+        sed -e "s/svg xmlns/svg fill='$3' xmlns/g" $1 > /tmp/tmp.svg
+        mv /tmp/tmp.svg $1
+  fi
+  rsvg-convert $1 -h $sheight -o /tmp/tmp.png;
+  convert /tmp/tmp.png -background none -gravity center -extent $width'x'$height $filename;
+done
