-  Respond(NoArguments());
-}
-
-void DeveloperPrivateDismissMv2DeprecationNoticeForExtensionFunction::
-    OnDialogCancelled() {
-  if (!browser_context()) {
-    return;
-  }
-
-  Respond(NoArguments());
-}
